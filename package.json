{
  "name": "next-app-router-bun",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAI-compatible chat template for Next.js App Router, ReScript, and Bun",
  "scripts": {
    "build": "rescript && next build",
    "build:turbo": "next build --turbopack",
    "dev": "next dev",
    "dev:tubro": "next dev --turbopack",
    "format": "biome format --write",
    "lint": "biome check",
    "res:build": "rescript",
    "res:clean": "rescript clean",
    "res:dev": "rescript -w",
    "start": "next start",
    "start:turbo": "next start"
  },
  "dependencies": {
    "@rescript/core": "^1.6.1",
    "@rescript/react": "^0.14.2",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rescript": "^11.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "gentype": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
