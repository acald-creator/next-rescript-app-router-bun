# OpenAI-compatible Chat Completions.
#
# Leave OPENAI_API_KEY and OPENAI_BASE_URL unset to use the local demo stream.
# Copy this file to .env.local and fill in a provider when you want a real model.

# Required for hosted providers. Optional for local servers like Ollama
# if the server does not check Authorization.
OPENAI_API_KEY=

# Default in code: https://api.openai.com/v1
# Examples:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   https://api.groq.com/openai/v1
#   http://localhost:11434/v1
OPENAI_BASE_URL=

# Default in code: gpt-4o-mini
OPENAI_MODEL=

# Optional system prompt prepended on the server.
# OPENAI_SYSTEM_PROMPT=You are a concise assistant.
